<div style="max-height: 600px;overflow-y: scroll">
    <fieldset class="{{#unless refinement.disabled}}droppable{{/unless}} refinement">
        <legend>{{localize "pf2e-monster-parts.dialog.refined-item-editor.refinement"}}</legend>
        <div class="form-group">
            <label for="refinement-type">{{localize
                "pf2e-monster-parts.dialog.refined-item-editor.type"}}</label>
            <select name="refinement-type" id="refinement-type" class="refinement-type">
                {{#each possibleRefinements }}
                    <option value="{{this.key}}"
                            {{#if (eq this.key ../refinement.key)}}selected{{/if}}>{{this.label}}
                    </option>
                {{/each}}
            </select>
        </div>
        <div class="form-group">
            <label for="refinement-value">{{localize "pf2e-monster-parts.dialog.refined-item-editor.value"}}</label>
            {{#if refinement.disabled}}
                <p>Handled by ARP</p>
                <input style="display:none" type="number" name="refinement-value" id="refinement-value" value="{{refinement.value}}"
                       step="0.01"/>
            {{else}}
                <input type="number" name="refinement-value" id="refinement-value" value="{{refinement.value}}"
                       step="0.01"/>
                <p style="flex-grow: 0">{{localize currencyLabel}}</p>
                {{#if (gt refinement.value 0)}}
                    <button id="refinement-extract" data-action="extractMaterial" style="flex-grow:0;"
                            data-material-key="{{refinement.key}}"
                            data-tooltip="{{localize
                                "pf2e-monster-parts.dialog.refined-item-editor.extract-button-tooltip"}}">
                        <i class="fa-solid fa-arrow-up-from-bracket"></i>
                    </button>
                {{/if}}
            {{/if}}

        </div>
    </fieldset>

    {{#each imbuements as | imbue |}}
        <fieldset class="droppable imbue">
            <legend>{{localize "pf2e-monster-parts.dialog.refined-item-editor.imbuement"}}</legend>
            <div class="form-group">
                <label for="imbue-{{@index}}-type">{{localize
                    "pf2e-monster-parts.dialog.refined-item-editor.type"}}</label>
                <select name="imbue-{{@index}}-type" id="imbue-{{@index}}-type" class="imbue-type">
                    <option value=""></option>
                    {{#each imbue.allowed }}
                        <option value="{{this.key}}"
                                {{#if (eq this.key ../this.key)}}selected{{/if}}>{{this.label}}</option>
                    {{/each}}
                </select></div>
            <div class="form-group">
                <label for="imbue-{{@index}}-value">{{localize
                    "pf2e-monster-parts.dialog.refined-item-editor.value"}}</label>
                <input type="number" name="imbue-{{@index}}-value" id="imbue-{{@index}}-value"
                       data-imbue-index="{{@index}}"
                       class="imbue-value"
                       value="{{this.value}}" step="0.01" />
                <p style="flex-grow: 0">{{localize ../currencyLabel}}</p>
                {{#if (gt this.value 0)}}
                    <button id="refinement-{{@index}}-extract" data-action="extractMaterial" style="flex-grow:0;"
                            data-material-key="{{this.key}}"
                            data-tooltip="{{localize
                                "pf2e-monster-parts.dialog.refined-item-editor.extract-button-tooltip"}}">
                        <i class="fa-solid fa-arrow-up-from-bracket"></i>
                    </button>
                {{/if}}
            </div>
        </fieldset>
    {{/each}}

    {{#if (gt newImbuements.length 0)}}
        <fieldset class="droppable new-imbue">
            <legend>{{localize "pf2e-monster-parts.dialog.refined-item-editor.new-imbuement"}}</legend>
            <div class="form-group">
                <label for="new-imbue-type">{{localize
                    "pf2e-monster-parts.dialog.refined-item-editor.type"}}</label>
                <select name="new-imbue-type" id="new-imbue-type">
                    <option value=""></option>
                    {{#each newImbuements }}
                        <option value="{{this.key}}">{{this.label}}</option>
                    {{/each}}
                </select></div>
            <div style="display: none" class="form-group">
                <label for="new-imbue-value">{{localize
                    "pf2e-monster-parts.dialog.refined-item-editor.value"}}</label>
                <input type="number" name="new-imbue-value" id="new-imbue-value"
                       value="0" step="0.01" />
            </div>
        </fieldset>
    {{/if}}
</div>